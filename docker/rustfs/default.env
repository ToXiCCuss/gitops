RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_OBS_LOGGER_LEVEL=info
TZ=Europe/Berlin
# Login with Keycloak (realm rjst, client rustfs of docker/keycloak-config/realms/rjst.yaml).
# The public address of the console is the NetBird reverse proxy s3-admin.proxy.rjst.de (to port 9001).
RUSTFS_BROWSER_REDIRECT_URL=https://s3-admin.proxy.rjst.de
RUSTFS_IDENTITY_OPENID_ENABLE=on
RUSTFS_IDENTITY_OPENID_CONFIG_URL=https://auth.proxy.rjst.de/realms/rjst
RUSTFS_IDENTITY_OPENID_CLIENT_ID=rustfs
RUSTFS_IDENTITY_OPENID_SCOPES=openid,profile,email
RUSTFS_IDENTITY_OPENID_REDIRECT_URI=https://s3-admin.proxy.rjst.de/rustfs/admin/v3/oidc/callback/default
RUSTFS_IDENTITY_OPENID_REDIRECT_URI_DYNAMIC=off
RUSTFS_IDENTITY_OPENID_DISPLAY_NAME=Keycloak
# The client roles of the Keycloak client arrive as the flat claim "roles". Their names are RustFS policies
# (consoleAdmin, readwrite, readonly).
RUSTFS_IDENTITY_OPENID_ROLES_CLAIM=roles
RUSTFS_IDENTITY_OPENID_EMAIL_CLAIM=email
RUSTFS_IDENTITY_OPENID_USERNAME_CLAIM=preferred_username
# auth.proxy.rjst.de may resolve to a private (NetBird) address, which RustFS blocks for outgoing requests otherwise
RUSTFS_OUTBOUND_ALLOW_ORIGINS=https://auth.proxy.rjst.de
# Secrets, set the real values in override.env (not in Git, see override.env.example)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=
