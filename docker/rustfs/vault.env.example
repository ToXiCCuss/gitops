# The keys of the secret docker/rustfs in Vault (vault kv put docker/rustfs NAME=value ...). scripts/docker/deploy.sh
# checks them before it touches a container: NAME= is required, #NAME= is optional.
# Root login of RustFS (emergency login and S3 admin), never the public default rustfsadmin. The access key has no
# space, the secret e.g. from `openssl rand -base64 24`. scripts/docker/setup-rustfs.sh reads both from here.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# The same value as RUSTFS_CLIENT_SECRET in the secret docker/keycloak-config
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=
