# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# Root login of RustFS (emergency login and S3 admin), never the public default rustfsadmin.
# The secret e.g. from `openssl rand -base64 24`.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# The same value as RUSTFS_CLIENT_SECRET in docker/keycloak-config/override.env
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=
