# SeaweedFS S3 (source). Use the address the docker host is reachable on from inside the container
S3_ENDPOINT=http://host.docker.internal:8333
# pCloud remote name in rclone.conf and target folders
PCLOUD_REMOTE=pCloud
PCLOUD_TARGET=/Backups/s3
PCLOUD_DELETED=/Backups-deleted
# Start time of the nightly sync in UTC, keep it after the backup window
SYNC_HOUR=05
SYNC_MINUTE=00
# Days files that were deleted or overwritten in the S3 stay in pCloud
RETENTION_DAYS=30
# Secrets, set the real values in .env (Arcane project env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uptime Kuma push URL, the sync reports success or failure there
PUSH_URL=
