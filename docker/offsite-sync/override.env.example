# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# The S3 keys of the identity "offsite-sync" come from Vault (docker/s3/offsite-sync, README: Setup RustFS), the names are checked over both.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
