# The keys of the secret docker/offsite-sync in Vault (vault kv put docker/offsite-sync NAME=value ...).
# scripts/docker/deploy.sh checks them before it touches a container: NAME= is required, #NAME= is optional.
# The S3 keys of the identity "offsite-sync" are not in this secret: deploy.sh adds them from docker/s3/offsite-sync.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Discord webhook URL for failed runs. The secret needs at least one key, so it is required here
DISCORD_WEBHOOK_URL=
