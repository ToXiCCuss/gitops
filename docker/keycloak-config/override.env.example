# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# These variables can come from Vault instead (docker/keycloak-config, README: Secrets from Vault): deploy.sh checks the names below over both.
# A user of the realm master with the role admin (a separate user for this job is better than your own)
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=
# The same value as in Vault argocd/data/prometheus#oidc.client_secret (Grafana reads it from there)
GRAFANA_CLIENT_SECRET=
# The same value as in Vault argocd/data/harbor#oidc.client_secret (Harbor reads it from there)
HARBOR_CLIENT_SECRET=
# The same value as in Vault argocd/data/jenkins#oidc.client_secret (Jenkins reads it from the Secret jenkins-oidc)
JENKINS_CLIENT_SECRET=
# The same value as in Vault argocd/data/vault#oidc.client_secret (scripts/vault/configure-vault-oidc.ps1 reads it from there)
VAULT_CLIENT_SECRET=
# The same values as in the Vault area of Spring Boot Admin per stage (engines dev and prod), the app reads them from there
SBA_DEV_CLIENT_SECRET=
SBA_PROD_CLIENT_SECRET=
# The same value as RUSTFS_IDENTITY_OPENID_CLIENT_SECRET in docker/rustfs/override.env (e.g. `openssl rand -base64 32`)
RUSTFS_CLIENT_SECRET=
