KEYCLOAK_URL=http://keycloak:8080
# Wait for Keycloak, it needs a while to start
KEYCLOAK_AVAILABILITYCHECK_ENABLED=true
KEYCLOAK_AVAILABILITYCHECK_TIMEOUT=180s
IMPORT_FILES_LOCATIONS=/config/*
# Replaces $(env:NAME) in the realm files, an undefined variable stops the import
IMPORT_VARSUBSTITUTION_ENABLED=true
TZ=Europe/Berlin
# Secrets, set the real values in override.env (not in Git, see override.env.example)
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=
GRAFANA_CLIENT_SECRET=
