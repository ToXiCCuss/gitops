# Combined NetBird Server Configuration (Simplified)
# Generated by getting-started.sh

server:
  listenAddress: ":80"
  exposedAddress: "https://proxy.rjst.de:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "__VAULT_NETBIRD_AUTH_SECRET__"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://proxy.rjst.de/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "__VAULT_NETBIRD_SESSION_COOKIE_ENCRYPTION_KEY__"
    dashboardRedirectURIs:
      - "https://proxy.rjst.de/nb-auth"
      - "https://proxy.rjst.de/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"
    trustedPeers:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    encryptionKey: "__VAULT_NETBIRD_STORE_ENCRYPTION_KEY__"
