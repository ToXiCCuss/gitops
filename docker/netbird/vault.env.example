# The keys of the secret docker/netbird in Vault (vault kv put docker/netbird NAME=value ...). scripts/docker/deploy.sh
# checks them before it touches a container, pre-deploy.sh writes them into /root/netbird/config.yaml and proxy.env.
# The values come from the installer of NetBird. NETBIRD_STORE_ENCRYPTION_KEY encrypts the database: it must never change,
# pre-deploy.sh refuses a value that differs from the one in /root/netbird/config.yaml.
# server.authSecret of config.yaml
NETBIRD_AUTH_SECRET=
# server.auth.sessionCookieEncryptionKey of config.yaml
NETBIRD_SESSION_COOKIE_ENCRYPTION_KEY=
# server.store.encryptionKey of config.yaml
NETBIRD_STORE_ENCRYPTION_KEY=
# NB_PROXY_TOKEN of proxy.env
NB_PROXY_TOKEN=
# NB_PROXY_CROWDSEC_API_KEY of proxy.env
NB_PROXY_CROWDSEC_API_KEY=
