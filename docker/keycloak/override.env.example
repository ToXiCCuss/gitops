# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# User and password of the database: printed by scripts/postgresql/db_create.sh keycloak (user keycloak_owner)
KC_DB_USERNAME=
KC_DB_PASSWORD=
# Only used while the master realm has no user (first start): create a personal admin in the UI, then delete admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
