# The public URL is the issuer in every token and in the config of every client, do not change it later.
# One URL only: Keycloak serves a single frontend URL.
KC_HOSTNAME=https://auth.proxy.rjst.de
KC_HOSTNAME_STRICT=true
# Calls to the published port 8180 (e.g. RustFS from a container) get the back-channel endpoints (token, JWKS) of the address
# they used. Issuer and login page stay on the public URL. Needs KC_HOSTNAME as a full URL.
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
# TLS ends at the NetBird reverse proxy
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
# One instance, no clustering
KC_CACHE=local
# PostgreSQL on the Docker host, database and role from scripts/postgresql/db_create.sh keycloak
KC_DB=postgres
KC_DB_URL_HOST=host.docker.internal
KC_DB_URL_DATABASE=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
TZ=Europe/Berlin
# Secrets: empty here, the values come from Vault (docker/keycloak), the names are in vault.env.example
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
