# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# setup-backup-host.sh writes the S3 keys of the identity "restic-backup" into override.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restic passwords of the repositories docker (also used for its copy in pCloud), vault and netbird.
# scripts/docker/setup-restic-backup.sh fills them in.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
