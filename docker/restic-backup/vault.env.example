# The keys of the secret docker/restic-backup in Vault (vault kv put docker/restic-backup NAME=value ...).
# scripts/docker/deploy.sh checks them before it touches a container: NAME= is required, #NAME= is optional.
# The S3 keys of the identity "restic-backup" are not in this secret: deploy.sh adds them from docker/s3/restic-backup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restic passwords of the repositories docker (also used for its copy in pCloud), vault and netbird.
# Also in the password manager: without them the backups cannot be read.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
