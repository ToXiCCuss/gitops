# The keys of the secret docker/restic-backup in Vault (vault kv put docker/restic-backup NAME=value ...).
# scripts/docker/deploy.sh checks them before it touches a container: NAME= is required, #NAME= is optional.
# The S3 keys of the identity "restic-backup" are not in this secret: deploy.sh adds them from docker/s3/restic-backup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Passwords of the backup logins (scripts/postgresql/backup_user_create.sh and scripts/mariadb/backup_user_create.sh keep them
# in databases/postgresql/backup and databases/mariadb/backup). Without MARIADB_PASSWORD MariaDB is not backed up
POSTGRES_PASSWORD=
#MARIADB_PASSWORD=
# Restic passwords of the repositories docker (also used for its copy in pCloud), databases, vault, netbird, forgejo and leantime.
# Also in the password manager: without them the backups cannot be read.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_DATABASES=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# The same value as in Vault argocd/data/forgejo#backup.restic_password (generate-secrets.ps1 copies it)
RESTIC_PASSWORD_FORGEJO=
# The same value as in Vault argocd/data/leantime#backup.restic_password (generate-secrets.ps1 copies it)
RESTIC_PASSWORD_LEANTIME=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
