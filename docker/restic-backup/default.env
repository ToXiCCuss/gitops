# RustFS S3 (the container reaches the host as host.docker.internal)
S3_ENDPOINT=http://host.docker.internal:9000
# Start time of the nightly run in UTC, after vault-backup and before the offsite sync
BACKUP_HOUR=03
BACKUP_MINUTE=00
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Share of the data that restic check reads in every run
CHECK_READ_DATA_SUBSET=10%
# Retention of the database dumps, per engine
DATABASES_KEEP_DAILY=14
DATABASES_KEEP_WEEKLY=8
DATABASES_KEEP_MONTHLY=6
# PostgreSQL and MariaDB run on the Docker host. The login is the backup login of scripts/<engine>/backup_user_create.sh
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=backup
MARIADB_HOST=host.docker.internal
MARIADB_PORT=3306
MARIADB_USER=backup
# Secrets: empty here, the values come from Vault (docker/restic-backup), the names are in vault.env.example
# Keys of the S3 identity "restic-backup"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Passwords of the backup logins
POSTGRES_PASSWORD=
MARIADB_PASSWORD=
# Restic passwords of the repositories docker (also used for its copy in pCloud), databases, vault and netbird.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_DATABASES=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# Discord webhook URL, the run reports failed steps there
DISCORD_WEBHOOK_URL=
