# SeaweedFS S3 (the container reaches the host as host.docker.internal)
S3_ENDPOINT=http://host.docker.internal:8333
# Start time of the nightly run in UTC, after vault-backup and before the offsite sync
BACKUP_HOUR=03
BACKUP_MINUTE=00
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Share of the data that restic check reads in every run
CHECK_READ_DATA_SUBSET=10%
# Secrets, set the real values in override.env (not in Git, see override.env.example)
# Keys of the S3 identity "restic-backup"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restic passwords of the repositories docker (also used for its copy in pCloud), vault and netbird.
# scripts/docker/setup-restic-backup.sh fills them in.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# Discord webhook URL, the run reports failed steps there
DISCORD_WEBHOOK_URL=
