# The keys of the secret docker/vault-backup in Vault (vault kv put docker/vault-backup NAME=value ...).
# scripts/docker/deploy.sh checks them before it touches a container: NAME= is required, #NAME= is optional.
# The S3 keys of the identity "vault" are not in this secret: deploy.sh adds them from docker/s3/vault.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Periodic token of the policy vault_snapshot (scripts/vault/create-snapshot-token.ps1)
VAULT_TOKEN=
# Password of the restic repository vault/raft
RESTIC_PASSWORD=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
