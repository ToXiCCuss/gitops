# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# setup-backup-host.sh writes the S3 keys of the identity "vault" into override.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Periodic token of the policy vault_snapshot (scripts/vault/create-snapshot-token.ps1)
VAULT_TOKEN=
# Password of the restic repository vault/raft
RESTIC_PASSWORD=
# optional: Discord webhook URL for failed runs
#DISCORD_WEBHOOK_URL=
