VAULT_ADDR=https://vault.k8sdev.rjst.de
# SeaweedFS S3 (the container runs in the host network)
S3_ENDPOINT=http://127.0.0.1:8333
# Start time of the nightly backup in UTC, keep it before the backups of Backrest and the offsite sync
BACKUP_HOUR=02
BACKUP_MINUTE=30
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Secrets, set the real values in .env (Arcane project env)
# Periodic token of the policy vault_snapshot, created by scripts/vault/create-snapshot-token.ps1
VAULT_TOKEN=
# Keys of the S3 identity "vault"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Password of the restic repository vault/raft
RESTIC_PASSWORD=
# Uptime Kuma push URL, the backup reports success or failure there
PUSH_URL=
