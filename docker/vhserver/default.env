TZ=Europe/Berlin
# On every start the container sets the user linuxgsm to this UID and GID and takes ownership of /data.
# GID is the group gs-vhserver of the folder (ansible/group_vars/all/main.yml), so the people with SFTP access keep their rights
UID=1000
GID=20000
# Minutes between update checks of the game server (60 = hourly)
UPDATE_CHECK=60
UPDATE_ON_START=true
