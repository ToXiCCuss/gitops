ARCANE_APP_URL=https://arcane.proxy.rjst.de
ARCANE_OIDC_ENABLED=true
ARCANE_OIDC_PROVIDER_NAME=Keycloak
ARCANE_OIDC_CLIENT_ID=arcane
ARCANE_OIDC_ISSUER_URL=https://auth.proxy.rjst.de/realms/rjst
ARCANE_OIDC_SCOPES=openid email profile
# A container cannot use https://auth.proxy.rjst.de (the NetBird proxy answers 403): the calls from Arcane go to
# Keycloak over the shared network (container keycloak:8080); the browser still uses the public authorization endpoint. Like RustFS (docs/backup-services.md: OIDC details)
ARCANE_OIDC_AUTHORIZATION_ENDPOINT=https://auth.proxy.rjst.de/realms/rjst/protocol/openid-connect/auth
ARCANE_OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/rjst/protocol/openid-connect/token
ARCANE_OIDC_USERINFO_ENDPOINT=http://keycloak:8080/realms/rjst/protocol/openid-connect/userinfo
ARCANE_OIDC_JWKS_ENDPOINT=http://keycloak:8080/realms/rjst/protocol/openid-connect/certs
# The client roles of Keycloak arrive as the claim "roles" (docker/keycloak-config/realms/rjst.yaml)
ARCANE_OIDC_GROUPS_CLAIM=roles
ARCANE_OIDC_ROLE_MAPPINGS=[{"claimValue":"admin","roleId":"role_admin"}]
# Git and deploy.sh control the lifecycle of Compose projects on docker01.
ARCANE_AUTO_UPDATE=false
ARCANE_AUTO_HEAL_ENABLED=false
ARCANE_SCHEDULED_PRUNE_ENABLED=false
# Largest file that can be viewed, edited or uploaded in a volume (MB)
ARCANE_VOLUME_WORKSPACE_MAX_FILE_SIZE_MB=1024
