# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# Passwords of the admin UI, e.g. from `openssl rand -base64 24`. Use only the read-only account (viewer) day to day:
# changes in the UI could replace the identities of s3.json. The admin password is required for the read-only account to work.
WEED_ADMIN_PASSWORD=
WEED_ADMIN_READONLY_PASSWORD=
