NB_LOG_LEVEL=info
# Plain WebSocket on this port, Traefik terminates TLS in front of it
NB_LISTEN_ADDRESS=:8080
# The address the peers get from management. rels:// although the relay itself speaks no TLS
NB_EXPOSED_ADDRESS=rels://relay.proxy.rjst.de:443
# Traefik of docker/netbird (fixed address in its network): the relay trusts the client address headers only from there
NB_TRUSTED_PROXIES=172.30.0.10
NB_ENABLE_STUN=true
NB_STUN_PORTS=3478
