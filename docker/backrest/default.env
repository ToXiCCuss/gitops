BACKREST_DATA=/data
BACKREST_CONFIG=/config/config.json
BACKREST_PORT=0.0.0.0:9898
XDG_CACHE_HOME=/cache
TMPDIR=/tmp
TZ=Europe/Berlin
# Secrets, set the real values in override.env (not in Git, see override.env.example)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
# Used by pre-deploy.sh to render config.template.json: the restic passwords of the repositories
# docker (the repository pcloud is its copy in pCloud), vault and netbird, and the Discord webhook
# for failed operations. scripts/docker/setup-backrest.sh fills them in.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
DISCORD_WEBHOOK_URL=
