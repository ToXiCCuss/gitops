# Copy to override.env and fill in. override.env is not in Git (scripts/docker/deploy.sh checks it).
# setup-backup-host.sh writes the S3 keys of the identity "backrest" into override.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restic passwords of the repositories docker (also used for its copy pcloud), vault and netbird
# (pre-deploy.sh puts them into config.json). scripts/docker/setup-backrest.sh fills them in.
RESTIC_PASSWORD_DOCKER=
RESTIC_PASSWORD_VAULT=
RESTIC_PASSWORD_NETBIRD=
# optional
#RESTIC_PASSWORD=
# optional: Discord webhook, Backrest reports failed operations there
#DISCORD_WEBHOOK_URL=
