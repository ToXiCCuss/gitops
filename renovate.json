{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone"
  ],
  "minimumReleaseAge": "3 days",
  "ignorePaths": [
    "kubernetes/archive/**",
    "kubernetes/parked/**"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/[^/]+/helm/.+\\.yaml$/",
      "/^kubernetes/kube-vault\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/[^/]+/kubectl/.+\\.yaml$/",
      "/^kubernetes/argocd-values\\.yaml$/"
    ]
  }
}
