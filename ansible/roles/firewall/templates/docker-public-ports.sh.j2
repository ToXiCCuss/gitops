#!/bin/sh
# Managed by Ansible (role firewall), do not edit.
# Docker publishes ports through the FORWARD chain, where UFW does not filter. This drops
# connections from the Internet to every published port that is not listed below.
# Traffic from other interfaces (NetBird, the Docker networks) is not affected.
set -eu

CHAIN=DOCKER-PUBLIC
INTERFACE={{ firewall_public_interface }}

iptables -N "$CHAIN" 2>/dev/null || true
iptables -F "$CHAIN"
{% for published in firewall_docker_public_ports %}
# {{ published.comment }}
iptables -A "$CHAIN" -i "$INTERFACE" -p {{ published.proto }} -m conntrack --ctstate DNAT --ctorigdstport {{ published.port }} -j RETURN
{% endfor %}
iptables -A "$CHAIN" -i "$INTERFACE" -m conntrack --ctstate DNAT -j DROP

iptables -C DOCKER-USER -j "$CHAIN" 2>/dev/null || iptables -I DOCKER-USER 1 -j "$CHAIN"
