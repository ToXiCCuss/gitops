# Managed by Ansible (roles/arcane) - do not edit on the host, changes are lost.
# APP_URL comes from host_config in group_vars/all/main.yml,
# the secrets from the ansible-vault encrypted group_vars/all/secrets.yml.
# Loaded after default.env in docker-compose.yml, so these values win.
APP_URL={{ arcane_app_url }}
ENCRYPTION_KEY={{ arcane_encryption_key }}
JWT_SECRET={{ arcane_jwt_secret }}
